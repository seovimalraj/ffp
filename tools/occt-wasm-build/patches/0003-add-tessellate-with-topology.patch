+emscripten::val TessellateWithTopology (const emscripten::val& buffer, const emscripten::val& opts)
+{
+    emscripten::val resultObj (emscripten::val::object ());
+    resultObj.set ("success", false);
+
+    std::string inputExt;
+    if (!GetStringOpt (opts, "ext", inputExt) && !GetStringOpt (opts, "inputExt", inputExt)) {
+        resultObj.set ("error", "Missing required topology options: ext or inputExt");
+        return resultObj;
+    }
+    inputExt = ToLower (inputExt);
+
+    ImportParams importParams;
+    if (!opts.isUndefined () && !opts.isNull () && opts.hasOwnProperty ("mesh")) {
+        importParams = GetImportParams (opts["mesh"]);
+    } else {
+        importParams = GetImportParams (opts);
+    }
+
+    ImporterPtr importer;
+    if (inputExt == "step" || inputExt == "stp") {
+        importer = std::make_shared<ImporterStep> ();
+    } else if (inputExt == "iges" || inputExt == "igs") {
+        importer = std::make_shared<ImporterIges> ();
+    } else if (inputExt == "brep") {
+        importer = std::make_shared<ImporterBrep> ();
+    } else {
+        resultObj.set ("error", "Unsupported source extension");
+        return resultObj;
+    }
+
+    const std::vector<uint8_t>& sourceBytes = emscripten::vecFromJSArray<std::uint8_t> (buffer);
+    Importer::Result importResult = importer->LoadFile (sourceBytes, importParams);
+    if (importResult != Importer::Result::Success) {
+        resultObj.set ("error", "Failed to load source CAD file");
+        return resultObj;
+    }
+
+    emscripten::val rootNodeObj (emscripten::val::object ());
+    emscripten::val meshesArr (emscripten::val::array ());
+    NodePtr rootNode = importer->GetRootNode ();
+
+    HierarchyWriter hierarchyWriter (meshesArr);
+    hierarchyWriter.WriteNode (rootNode, rootNodeObj);
+
+    resultObj.set ("success", true);
+    resultObj.set ("root", rootNodeObj);
+    resultObj.set ("meshes", meshesArr);
+    resultObj.set ("topology", BuildExactTopologyForImporter (importer));
     return resultObj;
 }
 
